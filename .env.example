# === OpenRouter / LLM ===
# Обязателен: без ключа приложение падает при старте с ясной ошибкой.
# Нужен обычный API-ключ (https://openrouter.ai/keys), а не ключ управления
# (Provisioning / Management key): им модели не вызвать, OpenRouter ответит 401.
OPENROUTER_API_KEY=sk-bNqymiCgvfZy7L-89YYKvQ
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Веб-приложение ===
# Запуск: uv run python -m llm_tutor.web → http://127.0.0.1:8000
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Аккаунты, веб-сессии и записи на курсы — общая БД; у каждого ученика своя
# БД курса в USERS_DIR.
ACCOUNTS_DB_PATH=data/accounts.sqlite3
USERS_DIR=data/users
# Материалы RAG (python -m llm_tutor.course.ingest) — общие для всех учеников.
MATERIALS_DB_PATH=data/materials.sqlite3
# Курсы, созданные преподавателем в админке: папка на курс (метаданные,
# модули, конспекты, источники, своя БД материалов).
COURSES_DIR=data/courses

# Источники для автоматического создания курса (файлы, GitHub, страница).
# SOURCE_MAX_BYTES — предел одного источника после нормализации в markdown.
SOURCE_MAX_BYTES=524288
SOURCES_MAX_COUNT=50
FETCH_TIMEOUT=20.0
FETCH_MAX_BYTES=2097152
GITHUB_MAX_FILES=40

# Подпись под логотипом в боковом меню.
APP_BRAND=ТЬЮТОР

# === Генерация курса преподавателем (админка → «Курсы») ===
# Отдельная модель: ответы длиннее и дороже, чем у тьютора, поэтому и лимит
# вывода, и таймаут заданы на клиента целиком — не как у TUTOR_MODEL.
GENERATOR_MODEL=anthropic/claude-sonnet-4.5
GENERATION_MAX_TOKENS=4096
GENERATION_TIMEOUT=180.0
GENERATION_TEMPERATURE=0.3
REGISTRATION_OPEN=true
# true — за HTTPS (обратный прокси): cookie сессии не уйдёт по HTTP.
COOKIE_SECURE=false

# Слой абстракции модели: смена модели = правка этого файла, не кода.
# Точный slug сверить с каталогом OpenRouter (GET /api/v1/models).
TUTOR_MODEL=anthropic/claude-sonnet-4.5
GRADER_MODEL=anthropic/claude-sonnet-4.5
EXTRACTOR_MODEL=anthropic/claude-sonnet-4.5

# Параметры генерации
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=2048

# === Модель ученика (Beta-счётчики) — Срез 4 ===
BETA_PRIOR_ALPHA=1.0
BETA_PRIOR_BETA=1.0
# Затухание к априору: x' = 1 + (x-1)*exp(-lambda*dt). dt в днях.
BETA_DECAY_LAMBDA=0.05
# Малый вес распространения успеха на прямые пререквизиты.
BETA_PROPAGATE_WEIGHT=0.15

# === Планировщик: веса приоритета — Срез 4 ===
# priority = w1*важность + w2*пробел + w3*готовность
#          + w4*срочность_повторения - w5*стоимость - w6*штраф_за_провал
PRIORITY_W1=0.25
PRIORITY_W2=0.25
PRIORITY_W3=0.20
PRIORITY_W4=0.15
PRIORITY_W5=0.10
PRIORITY_W6=0.05

# === Пороги режимов узла (0..1, mastery = alpha/(alpha+beta)) ===
MASTERY_SKIP_THRESHOLD=0.90
MASTERY_VERIFY_THRESHOLD=0.75
MASTERY_COMPRESSED_THRESHOLD=0.50

# === Анкета холодного старта — Срез 4.5 ===
# Вес самооценки (source='self') — слабое свидетельство.
SELF_EVIDENCE_WEIGHT=0.3

# === Рубричный грейдер — Срез 6 ===
# Вердикт модели по открытому ответу слабее проверки кодом: ни одно
# «высокоставочное» решение не принимается только по нему.
RUBRIC_EVIDENCE_WEIGHT=0.5

# === Почта: восстановление пароля по ссылке — Срез 71 ===
# Необязательна: пока SMTP_USER/SMTP_PASSWORD пусты, приложение работает в
# «режиме показа» — письмо со ссылкой целиком печатается в журнале сервера,
# и сценарий восстановления проходится насквозь.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
# ВАЖНО: это «пароль приложения» Google из 16 символов, а не пароль аккаунта —
# обычный пароль Gmail отвергает (ошибка 535). Как получить:
# myaccount.google.com → Безопасность → Двухэтапная аутентификация →
# «Пароли приложений» → создать пароль для «Почта».
SMTP_PASSWORD=
# Отправитель; пусто — возьмётся SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=llm·tutor
# Абсолютный адрес в письме. Обязательно поменять на внешний адрес сервера:
# иначе ссылка из письма ведёт на 127.0.0.1 — то есть на компьютер ученика.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Срок жизни ссылки (минуты) и число запросов письма на адрес в окне лимитера.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_LIMIT=3

# === Сборка контекста — Срез 5 ===
CONTEXT_DIALOG_TAIL=8
CONTEXT_RAG_TOP_K=4
# Бюджет пакета контекста в токенах. При нехватке режется материал, затем
# хвост диалога; правила, профиль и состояние — нет.
CONTEXT_BUDGET_TOKENS=8000
